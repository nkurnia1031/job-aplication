# Copy to .env and point this at the job_search database on your available MySQL instance.
DATABASE_URL=mysql://job_app:replace-me@127.0.0.1:3306/job_search

# Generate a random value with at least 32 bytes of entropy. Set the same value in
# the Codex process environment as JOB_APP_MCP_TOKEN (see README.md).
MCP_BEARER_TOKEN=change-me
HOST=127.0.0.1
PORT=3000
CANDIDATE_IMPORT_DIR=.candidate-inbox
CANDIDATE_DATA_DIR=data
